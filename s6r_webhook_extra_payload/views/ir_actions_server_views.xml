<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_server_action_form_webhook_extra_payload" model="ir.ui.view">
        <field name="name">ir.actions.server.form.webhook.extra.payload</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="base.view_server_action_form" />
        <field name="arch" type="xml">
            <field name="webhook_field_ids" position="after">
                <field
                    name="webhook_extra_payload"
                    string="Extra Payload"
                    groups="base.group_system"
                    placeholder="e.g. {'user_id': user.id}"
                />
            </field>
        </field>
    </record>
</odoo>
